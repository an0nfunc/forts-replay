{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fwr info --json, schema version 1",
  "description": "Summary of one Forts replay. A later release can add fields without a new schema version, so objects are open and consumers ignore fields they do not know; removing a field or changing its meaning bumps the version. Optional fields are absent when empty, and arrays that are present are never null. Every field comes from the replay file, which whoever supplies it controls: treat names as untrusted text, and steam_id and result as unverified claims (for a ranked match, check them against the Steam leaderboard).",
  "type": "object",
  "required": ["schema_version", "format_version", "frames", "duration", "ranked", "blocks", "records", "truncated", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "format_version": {"$ref": "#/$defs/u32", "description": "Header version: 1383 in game v1.38.2."},
    "frames": {"$ref": "#/$defs/u32", "description": "Physics frames at 25 per second."},
    "duration": {"type": "number", "minimum": 0, "description": "Seconds: frames / 25."},
    "ranked": {"type": "boolean"},
    "map": {"type": "string", "minLength": 1, "maxLength": 1024, "description": "The map's .fwe file."},
    "options": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 1024}},
    "players": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/player"}, "description": "The header's player table, spectators included."},
    "ai": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/ai"}, "description": "Forts the AI plays."},
    "commanders": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/commander"}, "description": "Each side's commander, by the game's save-name, such as commander-fb-fulminator, reported verbatim. A side without a commander is left out."},
    "result": {"$ref": "#/$defs/result"},
    "timelines": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/timeline"}, "description": "Commands per player, by player ID."},
    "state": {"$ref": "#/$defs/state"},
    "losses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/loss"}, "description": "Devices that vanished between two decoded snapshots with no upgrade or move naming them in the last two snapshot intervals and without being scrapped (an odd number of scrap commands named them), in snapshot order. Approximate: the AI's own actions are not recorded."},
    "builds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/build"}, "description": "Devices finished during the match, the starting forts left out, by frame, then device ID. Approximate: a device's build time is not stored, so a build is confirmed when its build progress holds, or falls after a rise slower than the time elapsed."},
    "device_types": {"type": "object", "minProperties": 1, "maxProperties": 1024, "propertyNames": {"pattern": "^(0|[1-9][0-9]{0,4})$"}, "additionalProperties": {"$ref": "#/$defs/save_name"}, "description": "Device type ID to the game's save-name, from the snapshots, naming the type_id of place commands. Header version 1383 only."},
    "blocks": {"type": "integer", "minimum": 1},
    "records": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean", "description": "Decoding stopped early; the rest is what decoded before."},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "i32": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "frame": {"type": "integer", "minimum": -1, "description": "Frame of the step the record was written in; -1 before the first."},
    "side": {"type": "integer", "minimum": 0, "maximum": 99, "description": "Team ID modulo 100: 1 or 2, 0 for a spectator."},
    "save_name": {"type": "string", "pattern": "^[ -~]{1,64}$", "description": "The game's save-name of a device type, such as reactor."},
    "numbers": {"type": "array", "items": {"type": "number"}},
    "counts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "state": {
      "type": "object",
      "required": ["frames", "teams", "sides", "players"],
      "description": "Series from the state snapshots, one point per decoded snapshot (every 5 seconds), header version 1383 only. Every series array has as many entries as frames.",
      "properties": {
        "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}, "description": "Frame of each snapshot."},
        "teams": {"type": "array", "maxItems": 18, "items": {"$ref": "#/$defs/team_series"}, "description": "Teams of the team list that own a device in a snapshot, team 0 left out, by team ID."},
        "sides": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/side_series"}},
        "players": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/player_series"}, "description": "Players on side 1 or 2, in header order."}
      }
    },
    "team_series": {
      "type": "object",
      "required": ["team", "side", "metal", "energy", "max_metal", "max_energy", "floated_metal", "floated_energy", "damage_dealt", "reactor_health", "struts", "strut_hp", "struts_lost", "nodes", "devices", "weapons"],
      "description": "One team's series; 0 at frames where the team is not in the team list.",
      "properties": {
        "team": {"$ref": "#/$defs/i32"},
        "side": {"$ref": "#/$defs/side"},
        "metal": {"$ref": "#/$defs/numbers", "description": "Metal held."},
        "energy": {"$ref": "#/$defs/numbers", "description": "Energy held."},
        "max_metal": {"$ref": "#/$defs/numbers", "description": "Metal storage cap."},
        "max_energy": {"$ref": "#/$defs/numbers", "description": "Energy storage cap."},
        "floated_metal": {"$ref": "#/$defs/numbers", "description": "Cumulative metal lost to full storage."},
        "floated_energy": {"$ref": "#/$defs/numbers", "description": "Cumulative energy lost to full storage."},
        "damage_dealt": {"$ref": "#/$defs/numbers", "description": "Cumulative damage dealt to enemies."},
        "reactor_health": {"$ref": "#/$defs/numbers", "description": "Summed health of the team's reactors, 0 when none is left."},
        "struts": {"$ref": "#/$defs/counts", "description": "The team's struts in any state."},
        "strut_hp": {"$ref": "#/$defs/numbers", "description": "Summed hit points of those struts."},
        "struts_lost": {"$ref": "#/$defs/counts", "description": "Struts lost since the previous point, approximate."},
        "nodes": {"$ref": "#/$defs/counts", "description": "The team's nodes with at least one strut."},
        "devices": {"$ref": "#/$defs/counts", "description": "The team's devices, weapons and reactors included."},
        "weapons": {"$ref": "#/$defs/counts", "description": "The team's weapons."}
      }
    },
    "side_series": {
      "type": "object",
      "required": ["side", "damage_taken"],
      "properties": {"side": {"enum": [1, 2]}, "damage_taken": {"$ref": "#/$defs/numbers", "description": "Cumulative damage the side took."}}
    },
    "player_series": {
      "type": "object",
      "required": ["slot", "team", "damage", "apm"],
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 8, "description": "The player's slot in players."},
        "team": {"type": "array", "items": {"$ref": "#/$defs/i32"}, "description": "The player's current team, 0 once they have left."},
        "damage": {"$ref": "#/$defs/numbers", "description": "Cumulative damage the player dealt, 0 once they have left."},
        "apm": {"$ref": "#/$defs/numbers", "description": "The game's actions-per-minute figure at the snapshot."}
      }
    },
    "loss": {
      "type": "object",
      "required": ["frame", "team", "device", "type_id", "name", "weapon"],
      "properties": {
        "frame": {"$ref": "#/$defs/frame", "description": "Frame of the first snapshot without the device."},
        "team": {"$ref": "#/$defs/i32"},
        "device": {"$ref": "#/$defs/u32"},
        "type_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "name": {"$ref": "#/$defs/save_name"},
        "weapon": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "required": ["frame", "team", "device", "type_id", "name", "weapon"],
      "properties": {
        "frame": {"$ref": "#/$defs/frame", "description": "Frame of the first snapshot at which the device's build progress stands at its final value; it finished in the 5 seconds before."},
        "team": {"$ref": "#/$defs/i32"},
        "device": {"$ref": "#/$defs/u32"},
        "type_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "name": {"$ref": "#/$defs/save_name"},
        "weapon": {"type": "boolean"}
      }
    },
    "kind": {"type": "string", "pattern": "^[a-z][a-z_]{0,31}$", "description": "Command kind: place, strut, link, delete_link, delete_node, scrap, upgrade, repair, door, fire, fire_blocked, ability, repair_link, repair_device, repair_area, portal_link, portal_reverse, fire_at or ammo. A later v1 release can add kinds; consumers skip entries and counts of kinds they do not know."},
    "player": {
      "type": "object",
      "required": ["id", "slot", "team", "side"],
      "properties": {
        "id": {"$ref": "#/$defs/u32", "description": "The player field of the player's records."},
        "slot": {"$ref": "#/$defs/u32"},
        "team": {"$ref": "#/$defs/i32", "description": "Side + 100 × fort, or plain 1 and 2; -3 for a spectator."},
        "side": {"$ref": "#/$defs/side"},
        "name": {"type": "string", "minLength": 1, "maxLength": 15, "description": "Player-chosen, up to 15 UTF-16 code units, and may hold control, format and bidi characters, which the JSON escapes. Absent for the opponent in a ranked replay, whose header holds a generic word instead."},
        "steam_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "description": "SteamID64 in decimal, from the player's header entry, for every player whose entry holds one (not in single-player games)."},
        "recorder": {"const": true, "description": "The client that recorded the replay."}
      }
    },
    "ai": {
      "type": "object",
      "required": ["team", "side"],
      "properties": {"team": {"$ref": "#/$defs/i32"}, "side": {"$ref": "#/$defs/side"}}
    },
    "commander": {
      "type": "object",
      "required": ["side", "name"],
      "properties": {"side": {"enum": [1, 2]}, "name": {"type": "string", "minLength": 1, "maxLength": 49}}
    },
    "result": {
      "type": "object",
      "required": ["winner", "frame", "source"],
      "properties": {
        "winner": {"enum": [1, 2], "description": "Winning side."},
        "frame": {"$ref": "#/$defs/frame"},
        "source": {"enum": ["ranked", "snapshot"], "description": "ranked: the game's ranked result record, exact to the frame. snapshot: the first state snapshot after the end, up to 5 seconds late."}
      }
    },
    "timeline": {
      "type": "object",
      "required": ["player", "counts", "commands"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"},
        "counts": {"type": "object", "propertyNames": {"$ref": "#/$defs/kind"}, "additionalProperties": {"type": "integer", "minimum": 1}, "description": "Records per kind, including those past the timeline limit, without the first record of a strut or link pair, the start and end records of an immediate fire, repeated fire_blocked records and the doors the game opens and closes for a weapon. One area-repair drag writes several repair_area records, and one group fire one fire_at or fire per weapon."},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "description": "In replay order, up to the timeline limit."}
      }
    },
    "entry": {
      "type": "object",
      "required": ["frame", "kind", "fields"],
      "properties": {"frame": {"$ref": "#/$defs/frame"}, "kind": {"$ref": "#/$defs/kind"}, "fields": {"type": "object"}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "place"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/place"}}}},
        {"if": {"properties": {"kind": {"const": "strut"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/strut"}}}},
        {"if": {"properties": {"kind": {"const": "link"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/link"}}}},
        {"if": {"properties": {"kind": {"const": "delete_link"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/two_nodes"}}}},
        {"if": {"properties": {"kind": {"const": "delete_node"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/node"}}}},
        {"if": {"properties": {"kind": {"const": "scrap"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/device"}}}},
        {"if": {"properties": {"kind": {"const": "upgrade"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/device"}}}},
        {"if": {"properties": {"kind": {"const": "repair"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/node"}}}},
        {"if": {"properties": {"kind": {"const": "door"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/door"}}}},
        {"if": {"properties": {"kind": {"const": "fire"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/fire"}}}},
        {"if": {"properties": {"kind": {"const": "fire_blocked"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/fire_blocked"}}}},
        {"if": {"properties": {"kind": {"const": "ability"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/ability"}}}},
        {"if": {"properties": {"kind": {"const": "repair_link"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/repair_link"}}}},
        {"if": {"properties": {"kind": {"const": "repair_device"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/repair_device"}}}},
        {"if": {"properties": {"kind": {"const": "repair_area"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/repair_area"}}}},
        {"if": {"properties": {"kind": {"const": "portal_link"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/portal_link"}}}},
        {"if": {"properties": {"kind": {"const": "portal_reverse"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/portal_reverse"}}}},
        {"if": {"properties": {"kind": {"const": "fire_at"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/fire_at"}}}},
        {"if": {"properties": {"kind": {"const": "ammo"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/ammo"}}}}
      ]
    },
    "place": {
      "type": "object",
      "required": ["player", "team", "t", "type_id", "node_a", "node_b", "x", "y", "aim", "moved_device"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}, "t": {"type": "number"}, "type_id": {"$ref": "#/$defs/u32"},
        "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"},
        "x": {"type": "number"}, "y": {"type": "number"}, "aim": {"type": "number"},
        "moved_device": {"$ref": "#/$defs/i32"}
      }
    },
    "strut": {
      "type": "object",
      "required": ["player", "serial", "x", "y", "dx", "dy", "source", "material", "first", "anchored"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "serial": {"$ref": "#/$defs/u32"},
        "x": {"type": "number"}, "y": {"type": "number"}, "dx": {"type": "number"}, "dy": {"type": "number"},
        "source": {"$ref": "#/$defs/u32"}, "material": {"$ref": "#/$defs/u32"},
        "first": {"type": "boolean"}, "anchored": {"type": "boolean"}
      }
    },
    "link": {
      "type": "object",
      "required": ["player", "team", "node_a", "node_b", "material", "first"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}, "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"},
        "material": {"$ref": "#/$defs/u32"}, "first": {"type": "boolean"}
      }
    },
    "two_nodes": {
      "type": "object",
      "required": ["player", "team", "node_a", "node_b"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"},
        "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"}
      }
    },
    "node": {
      "type": "object",
      "required": ["player", "team", "node"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}, "node": {"$ref": "#/$defs/u32"}}
    },
    "device": {
      "type": "object",
      "required": ["player", "team", "device"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}, "device": {"$ref": "#/$defs/u32"}}
    },
    "door": {
      "type": "object",
      "required": ["player", "state", "node_a", "node_b", "source", "device"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "state": {"$ref": "#/$defs/u32"},
        "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"},
        "source": {"$ref": "#/$defs/u32"}, "device": {"$ref": "#/$defs/u32"}
      }
    },
    "fire": {
      "type": "object",
      "required": ["player", "device", "angle", "power", "immediate"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "device": {"$ref": "#/$defs/u32"},
        "angle": {"type": "number"}, "power": {"type": "number"}, "immediate": {"type": "boolean"}
      }
    },
    "fire_blocked": {
      "type": "object",
      "required": ["player", "device", "angle"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "device": {"$ref": "#/$defs/u32"}, "angle": {"type": "number"}}
    },
    "ability": {
      "type": "object",
      "required": ["player", "team"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}}
    },
    "repair_link": {
      "type": "object",
      "required": ["player", "team", "node_a", "node_b"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"},
        "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"}
      }
    },
    "repair_device": {
      "type": "object",
      "required": ["player", "team", "device"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"}, "device": {"$ref": "#/$defs/u32"}}
    },
    "repair_area": {
      "type": "object",
      "required": ["player", "team", "x", "y", "radius"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "team": {"$ref": "#/$defs/i32"},
        "x": {"type": "number"}, "y": {"type": "number"}, "radius": {"type": "number"}
      }
    },
    "portal_link": {
      "type": "object",
      "required": ["player", "node_a", "node_b", "other_a", "other_b"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"},
        "other_a": {"$ref": "#/$defs/u32"}, "other_b": {"$ref": "#/$defs/u32"}
      }
    },
    "portal_reverse": {
      "type": "object",
      "required": ["player", "node_a", "node_b"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "node_a": {"$ref": "#/$defs/u32"}, "node_b": {"$ref": "#/$defs/u32"}}
    },
    "fire_at": {
      "type": "object",
      "required": ["player", "x", "y", "angle", "device", "spotter"],
      "properties": {
        "player": {"$ref": "#/$defs/u32"}, "x": {"type": "number"}, "y": {"type": "number"}, "angle": {"type": "number"},
        "device": {"$ref": "#/$defs/u32"}, "spotter": {"$ref": "#/$defs/u32"}
      }
    },
    "ammo": {
      "type": "object",
      "required": ["player", "ammo", "device"],
      "properties": {"player": {"$ref": "#/$defs/u32"}, "ammo": {"$ref": "#/$defs/i32"}, "device": {"$ref": "#/$defs/u32"}}
    }
  }
}
